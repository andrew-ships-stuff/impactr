---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/site';
const {
  title = 'Impactr — Visualize the Impact of Every Code Change',
  description = 'Impactr is a Go-native, CPU-first Git architecture analyzer that visualizes code changes, traces affected dependencies, and brings AI-assisted impact analysis into your local development workflow.',
  noindex = false,
} = Astro.props;
const relativePath = Astro.url.pathname.replace(/^\/impactr\/?/, '').replace(/^\//, '');
const canonical = new URL(relativePath, 'https://andrew-ships-stuff.github.io/impactr/');
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#07110f" />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://andrew-ships-stuff.github.io/impactr/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={title} /><meta name="twitter:description" content={description} /><meta name="twitter:image" content="https://andrew-ships-stuff.github.io/impactr/og-image.png" />
    <title>{title}</title>
    <script is:inline>try{const t=localStorage.getItem('impactr-theme');if(t)document.documentElement.dataset.theme=t}catch{}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <style>.skip-link{position:fixed;top:.5rem;left:.5rem;z-index:100;transform:translateY(-150%);background:var(--text);color:var(--bg);padding:.7rem 1rem}.skip-link:focus{transform:none}</style>
  </body>
</html>
