---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowDown, Binary, Braces, Boxes, Cpu, FileBraces, GitCompareArrows, Layers, Network, PackageCheck } from '@lucide/astro';
---
<BaseLayout title="How Impactr Works — Architecture" description="Explore Impactr's Go-native deterministic analysis, canonical graphs, rendering pipeline, and bounded inference design.">
  <section class="page-hero section"><div class="site-shell"><p class="eyebrow">Internal architecture</p><h1 class="display">Evidence flows<br/>in one direction.</h1><p class="lede">Adapters feed deterministic analysis. Renderers and inference consume versioned facts. Natural-language output never becomes graph truth.</p></div></section>
  <section class="section"><div class="site-shell"><div class="architecture-map panel"><div class="map-row inputs"><div><GitCompareArrows/><b>Git snapshots</b><span>commit · index · tree</span></div></div><ArrowDown class="arrow"/><div class="map-row workers"><div><Braces/><b>Go analyzer</b><span>symbols + calls</span></div><div><Binary/><b>TS / Python</b><span>syntax-level facts</span></div><div><Boxes/><b>Bounded workers</b><span>cache-aware</span></div></div><ArrowDown class="arrow"/><div class="map-row canon"><div><Network/><b>Canonical graph</b><span>stable IDs · evidence · sorted output</span></div></div><div class="branches"><i></i><i></i><i></i></div><div class="map-row outputs"><div><GitCompareArrows/><b>Graph diff</b><span>added · removed · modified</span></div><div><Layers/><b>Blast radius</b><span>bounded reverse walk</span></div><div><Cpu/><b>Inference</b><span>validated evidence IDs</span></div></div><ArrowDown class="arrow"/><div class="map-row artifacts"><div><FileBraces/><b>JSON + diagrams</b><span>versioned artifacts</span></div><div><PackageCheck/><b>Review adapters</b><span>CLI · hooks · GitHub · GitLab</span></div></div></div></div></section>
  <section class="section principles"><div class="site-shell"><p class="eyebrow">Engineering principles</p><h2 class="section-title">Designed for repeatable inspection.</h2><div class="principle-grid"><article><span>01</span><h3>Snapshot isolation</h3><p>Committed revisions are read through `git archive`; Impactr never checks out a comparison revision. The index is extracted to an isolated temporary directory.</p></article><article><span>02</span><h3>Identity over position</h3><p>Node IDs hash language, package, qualified symbol, and kind — not line numbers. Unchanged concepts survive routine file movement.</p></article><article><span>03</span><h3>Bounded work</h3><p>Worker limits, graph depth, node budgets, render caps, inference memory, and timeouts make resource use explicit.</p></article><article><span>04</span><h3>Deterministic aggregation</h3><p>Concurrent analysis joins into sorted canonical facts. Caches use content, configuration, and analyzer hashes.</p></article><article><span>05</span><h3>Honest uncertainty</h3><p>Dynamic dispatch and unresolved symbols stay unresolved. Reachable dependents are labeled potentially affected, not broken.</p></article><article><span>06</span><h3>Validated explanation</h3><p>Inference receives a compact graph projection. Claims without real node or edge IDs are discarded.</p></article></div></div></section>
  <section class="section schema"><div class="site-shell schema-layout"><div><p class="eyebrow">Schema compatibility</p><h2 class="section-title">Built for tools, not only screenshots.</h2><p class="lede">Every JSON envelope carries schema version `1.0.0`. Additive fields fit within 1.x; breaking semantic changes require 2.0. Consumers should reject unknown major versions.</p></div><pre><code>&#123;
  <span>"schema_version"</span>: "1.0.0",
  <span>"before"</span>: &#123; "nodes": [...] &#125;,
  <span>"after"</span>: &#123; "nodes": [...] &#125;,
  <span>"diff"</span>: &#123; "summary": &#123; ... &#125; &#125;,
  <span>"impact"</span>: &#123; "affected": [...] &#125;,
  <span>"explanation"</span>: &#123; "claims": [...] &#125;
&#125;</code></pre></div></section>
</BaseLayout>
<style>
  .page-hero{background:var(--bg-soft);border-bottom:1px solid var(--line)}.page-hero .lede{max-width:760px}.architecture-map{padding:2rem;background-image:radial-gradient(var(--line) .7px,transparent .7px);background-size:18px 18px}.map-row{display:flex;justify-content:center;gap:1rem}.map-row>div{min-width:180px;display:grid;place-items:center;gap:.35rem;border:1px solid var(--line);background:var(--surface-solid);padding:1rem;text-align:center}.map-row svg{color:var(--accent)}.map-row span{color:var(--muted);font:.65rem var(--font-mono)}.map-row.canon>div{width:min(440px,100%);border-color:var(--added)}.arrow{display:block;margin:1rem auto;color:var(--line-strong)}.branches{width:68%;height:35px;margin:auto;border-top:1px solid var(--line-strong);border-inline:1px solid var(--line-strong)}.artifacts{margin-top:1rem}.principles{background:var(--bg-soft);border-block:1px solid var(--line)}.principle-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);margin-top:3rem}.principle-grid article{padding:1.5rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--surface)}.principle-grid article:nth-child(3n){border-right:0}.principle-grid article:nth-child(n+4){border-bottom:0}.principle-grid span{color:var(--accent);font:.7rem var(--font-mono)}.principle-grid h3{font-size:1.05rem}.principle-grid p{color:var(--muted);line-height:1.6;font-size:.85rem}.schema-layout{display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center}.schema pre{padding:1.5rem;background:var(--code-bg);color:var(--code-text);overflow:auto;font:.78rem/1.8 var(--font-mono)}.schema pre span{color:#49d6c6}@media(max-width:800px){.workers,.outputs{flex-direction:column;align-items:center}.branches{display:none}.principle-grid{grid-template-columns:1fr 1fr}.principle-grid article:nth-child(3n){border-right:1px solid var(--line)}.principle-grid article:nth-child(2n){border-right:0}.principle-grid article:nth-child(n+4){border-bottom:1px solid var(--line)}.principle-grid article:nth-child(n+5){border-bottom:0}.schema-layout{grid-template-columns:1fr;gap:2rem}}@media(max-width:520px){.principle-grid{grid-template-columns:1fr}.principle-grid article{border-right:0!important;border-bottom:1px solid var(--line)!important}.principle-grid article:last-child{border-bottom:0!important}.artifacts{flex-direction:column;align-items:center}}
</style>
