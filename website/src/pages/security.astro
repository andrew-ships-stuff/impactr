---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowRight, CloudOff, FileCheck, KeyRound, Laptop, LockKeyhole, ShieldCheck, TriangleAlert } from '@lucide/astro';
import { url } from '../lib/site';
---
<BaseLayout title="Security & Privacy — Impactr" description="Understand Impactr's local-first privacy model, external inference boundaries, and secure CI publishing design.">
  <section class="page-hero section"><div class="site-shell"><p class="eyebrow">Security model</p><h1 class="display">Local by default.<br/>Explicit at every boundary.</h1><p class="lede">Impactr can analyze and render without a network service. When data crosses a process, provider, or CI trust boundary, the choice should be visible and controlled.</p></div></section>
  <section class="section"><div class="site-shell trust-grid"><article><Laptop/><h2>Local analysis</h2><p>Git extraction, parsing, graph comparison, blast radius, and rendering happen on the machine running the CLI.</p><span>Source stays local</span></article><article><CloudOff/><h2>Embedded inference</h2><p>The optional model runs on the CPU. Installation is explicit and checksum-verified; analysis never downloads weights implicitly.</p><span>No inference server</span></article><article><KeyRound/><h2>External providers</h2><p>Only when configured, structured names, paths, signatures, evidence summaries, and relationships go to your endpoint.</p><span>Provider policy applies</span></article></div></section>
  <section class="section ci-boundary"><div class="site-shell"><div class="section-head"><div><p class="eyebrow">CI trust boundaries</p><h2 class="section-title">A diagram is data. A fork is untrusted code.</h2></div><p class="lede">Keep analysis and publication privileges separate for fork pull requests.</p></div><div class="boundary-flow"><div><TriangleAlert/><strong>Fork pull request</strong><span>read-only token · no secrets</span></div><ArrowRight/><div><FileCheck/><strong>Artifact-only analysis</strong><span>no privileged comment</span></div><ArrowRight/><div><ShieldCheck/><strong>Validate + verify</strong><span>schema · limits · API identity</span></div><ArrowRight/><div><LockKeyhole/><strong>Trusted publisher</strong><span>write token · default-branch code</span></div></div><div class="never"><strong>Never:</strong> use <code>pull_request_target</code> to check out and execute fork code with write permission. Never source or execute transferred artifact contents.</div></div></section>
  <section class="section"><div class="site-shell controls"><div><p class="eyebrow">Controls that exist today</p><h2 class="section-title">Concrete constraints, not privacy theater.</h2></div><ul><li><b>Explicit model install</b><span>License and checksum shown before download.</span></li><li><b>Environment-only credentials</b><span>`IMPACTR_API_KEY` is not a YAML field and is not logged.</span></li><li><b>Bounded artifact validation</b><span>Bundle, JSON, schema, image dimensions, and markers are checked.</span></li><li><b>No command configuration</b><span>Unknown YAML fields and unsupported versions are rejected.</span></li><li><b>Deterministic fallback</b><span>Provider failure does not remove graph results.</span></li></ul></div></section>
  <section class="report"><div class="site-shell"><div><p class="eyebrow">Report responsibly</p><h2>Found a vulnerability?</h2><p>Follow the private reporting process in the repository security policy. Do not open a public issue for an undisclosed vulnerability.</p></div><a class="btn btn-primary" href="https://github.com/andrew-ships-stuff/impactr/security/policy">Read SECURITY.md <ArrowRight size={16}/></a><a class="btn btn-secondary" href={url('/docs/security/')}>Security documentation</a></div></section>
</BaseLayout>
<style>
  .page-hero{background:var(--bg-soft);border-bottom:1px solid var(--line)}.page-hero .lede{max-width:800px}.trust-grid{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}.trust-grid article{padding:2rem;border-right:1px solid var(--line)}.trust-grid article:last-child{border:0}.trust-grid svg{color:var(--accent)}.trust-grid h2{font-size:1.3rem}.trust-grid p{color:var(--muted);line-height:1.65}.trust-grid span{display:inline-block;color:var(--added);font:.68rem var(--font-mono);text-transform:uppercase}.ci-boundary{background:var(--bg-soft);border-block:1px solid var(--line)}.section-head{display:grid;grid-template-columns:1fr .6fr;gap:3rem;align-items:end}.boundary-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;align-items:center;gap:.7rem;margin-top:3rem}.boundary-flow>div{min-height:150px;display:flex;flex-direction:column;justify-content:center;gap:.45rem;border:1px solid var(--line);background:var(--surface);padding:1rem}.boundary-flow svg{color:var(--accent)}.boundary-flow span{color:var(--muted);font-size:.75rem}.never{margin-top:1rem;border-left:3px solid var(--removed);background:color-mix(in srgb,var(--removed) 6%,var(--surface));padding:1rem;color:var(--muted)}.never strong{color:var(--text)}.controls{display:grid;grid-template-columns:1fr 1fr;gap:5rem}.controls ul{list-style:none;padding:0;margin:0;border-top:1px solid var(--line)}.controls li{display:grid;gap:.3rem;padding:1rem 0;border-bottom:1px solid var(--line)}.controls li span{color:var(--muted);font-size:.85rem}.report{padding:4rem 0;background:#0b211b;color:#edf8f3}.report .site-shell{display:grid;grid-template-columns:1fr auto auto;gap:1rem;align-items:center}.report h2{font-size:2rem;margin:.4rem 0}.report p{color:#a8bdb5}.report .btn-primary{background:#edf8f3;color:#07110f}@media(max-width:900px){.boundary-flow{grid-template-columns:1fr}.boundary-flow>svg{transform:rotate(90deg);margin:auto}.report .site-shell{grid-template-columns:1fr}.controls{grid-template-columns:1fr;gap:2rem}}@media(max-width:680px){.trust-grid,.section-head{grid-template-columns:1fr}.trust-grid article{border-right:0;border-bottom:1px solid var(--line)}}
</style>
